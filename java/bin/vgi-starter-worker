#!/bin/sh
# Run the worker: what DuckDB's ATTACH ... LOCATION points at.
#   bin/vgi-starter-worker                      stdio (DuckDB spawns it)
#   bin/vgi-starter-worker --http --port 8000   HTTP
#   bin/vgi-starter-worker --unix /tmp/w.sock   AF_UNIX (LOCATION 'launch:...')
# Build the jar first: make build (./gradlew shadowJar). JAVA_OPTS adds JVM flags.
# JAVA_HOME selects the JDK (25 or newer), else `java` on the PATH.
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
jar="$here/build/libs/vgi-starter-worker-all.jar"
[ -f "$jar" ] || { echo "vgi-starter-worker: $jar not found; run 'make build'" >&2; exit 1; }
java="${JAVA_HOME:+$JAVA_HOME/bin/}java"
# shellcheck disable=SC2086
exec "$java" \
  --add-opens=java.base/java.nio=ALL-UNNAMED --enable-native-access=ALL-UNNAMED \
  --sun-misc-unsafe-memory-access=allow \
  -Dio.netty.noUnsafe=false $JAVA_OPTS -jar "$jar" "$@"
