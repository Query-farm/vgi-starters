<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vgi-starter-worker</AssemblyName>
    <RootNamespace>Starter.Worker</RootNamespace>
    <!-- The release and Docker targets; listed so packages.lock.json covers them. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
    <Description>A VGI worker for DuckDB, generated from the Query.Farm VGI starter template.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QueryFarm.Vgi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starter.Worker.Tests" />
  </ItemGroup>

</Project>
